{
  "name": "tw-framework",
  "version": "1.0.0",
  "description": "TW Framework \u2014 full-stack web framework with its own template language, styling language, compiler and VDOM",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "tw": "./apps/cli/tw/bin.ts"
  },
  "scripts": {
    "postinstall": "bun run scripts/link-workspaces.ts",
    "dev": "bun run apps/cli/tw/bin.ts dev",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "lint": "bash scripts/typecheck.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:all": "bun run scripts/publish-all.ts",
    "verify": "bash scripts/verify-all.sh",
    "evals": "bun evals/run.ts",
    "bench": "bun bench/run.ts",
    "bench:check": "bun bench/run.ts --check",
    "bench:record": "bun bench/run.ts --record"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "keywords": [
    "framework",
    "web",
    "ssr",
    "ssg",
    "compiler",
    "typescript",
    "bun",
    "template",
    "vdom"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tw-origin/tw-framework.git"
  },
  "homepage": "https://github.com/tw-origin/tw-framework",
  "bugs": {
    "url": "https://github.com/tw-origin/tw-framework/issues"
  },
  "author": "Mlk Raj"
}