import { findProduct } from "catalog"

let carts = new Map()

fn post(request) {
  const b = request.body ?? {}
  const product = findProduct(String(b.id ?? ""))
  if (!product) return { status: 404, json: { ok: false, error: "unknown product id" } }
  const qty = Math.max(1, Number(b.qty ?? 1))
  const sid = String(request.query?.sid ?? "anon")
  const cart = carts.get(sid) ?? { lines: [], total: 0 }
  cart.lines.push({ id: product.id, name: product.name, price: product.price, qty })
  cart.total += product.price * qty
  carts.set(sid, cart)
  return { status: 200, json: { ok: true, lines: cart.lines.length, total: cart.total } }
}

fn get(request) {
  const sid = String(request.query?.sid ?? "anon")
  const cart = carts.get(sid) ?? { lines: [], total: 0 }
  return { status: 200, json: { ok: true, ...cart } }
}
