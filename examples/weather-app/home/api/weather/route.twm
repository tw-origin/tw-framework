let drift = 0

fn cached get(request) {
  cache { revalidate 10, expire 60, tag "weather" }
  const city = String(request.query?.city ?? "delhi")
  drift = (drift + 1) % 3
  const readings = {
    delhi: { temp: 31 + drift, cond: "Haze" },
    mumbai: { temp: 29 + drift, cond: "Humid" },
    bengaluru: { temp: 24 + drift, cond: "Pleasant" },
    chennai: { temp: 33 + drift, cond: "Sunny" },
  }
  const r = readings[city]
  if (!r) return { status: 404, json: { ok: false, error: "unknown city" } }
  return { status: 200, json: { city, ...r } }
}
