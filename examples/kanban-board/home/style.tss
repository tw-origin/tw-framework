.head { mb 20px }
.head h1 { fs 28px; mb 8px }
.head p { c #445 }
.columns { d grid; grid-template-columns repeat(3, 1fr); gap 16px }
.col { bg #f2f4f7; br 14px; p 14px }
.colhead { d flex; jc space-between; mb 10px }
.colhead h2 { fs 15px }
.count { bg #111; c #fff; br 999px; p 1px 9px; fs 13px; fw 700 }
.card { bg #fff; br 10px; p 12px; mb 8px; box-shadow 0 1px 2px rgba(0,0,0,0.06) }
.card p { fs 14px; mb 8px }
.card button { p 6px 10px; br 8px; bg #16a34a; c #fff; fw 600; fs 12px }
.col button { p 6px 10px; br 8px; bg #e2e6ec; fw 600; fs 12px; mt 4px }
.hold { fs 12px; c #889 }
.total { fs 12px; c #889; mt 8px }
