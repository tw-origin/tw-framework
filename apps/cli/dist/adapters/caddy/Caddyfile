# Caddyfile for TW Framework
# Generated by `tw adapter caddy`.
#
# Replace example.com with your domain. Caddy issues and renews HTTPS
# certificates automatically.
#
# Static output only (pages + pre-rendered routes). For the full server,
# run `tw serve` (or the node/bun adapter) and proxy to it instead:
#
#   example.com {
#       reverse_proxy 127.0.0.1:8000
#   }

example.com {
    root * .tw
    encode gzip

    # Hashed assets never change — cache them forever.
    @immutable path /assets/* /js/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # Clean URLs: /about serves about/index.html
    try_files {path} {path}/ /{path}.html
    file_server
}
